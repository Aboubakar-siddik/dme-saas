// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  DOCTOR
  SECRETARY
}

model Clinic {
  id        String   @id @default(cuid())
  name      String
  address   String?
  phone     String?
  email     String?
  logo      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users    User[]
  patients Patient[]
  visits   Visit[]

  @@map("clinics")
}

// 3. Puis le modèle User (qui utilise UserRole)
model User {
  id           String   @id @default(cuid())
  clinicId     String
  email        String   @unique
  passwordHash String
  role         UserRole
  firstName    String
  lastName     String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId])
  @@map("users")
}

model Patient {
  id             String   @id @default(cuid())
  clinicId       String
  clinic   Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  firstName      String
  lastName       String
  phoneNumber    String
  dateOfBirth    DateTime?
  sex            String?
  bloodGroup     String?
  allergies      String?
  medicalHistory String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  

  visits Visit[]

  // Index pour la recherche rapide
  @@unique([clinicId, phoneNumber])
  @@index([clinicId, lastName, firstName])
  @@index([clinicId, phoneNumber])
  @@map("patients")
}

model Visit {
  id           String   @id @default(cuid())
  patientId    String
  clinicId     String
  clinic   Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  doctorId     String?
  secretaryId  String?
  visitDate    DateTime @default(now())
  reason       String
  status       String   @default("WAITING")
  observations String?
  diagnosis    String?
  prescription String?
  fee          Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([clinicId, visitDate])
  @@index([patientId])
  @@index([doctorId, status])
  @@map("visits")
}

